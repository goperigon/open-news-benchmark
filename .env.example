# ─── Runner metadata (recorded in results) ───
BENCH_REGION=us-east
PERIGON_PLAN_TIER=real-time

# ─── Perigon (required for latency runs against Perigon) ───
PERIGON_API_KEY=
API_BASE_URL=https://api.perigon.io

# ─── Optional daily request budgets (BYOK tiers) ───
# PERIGON_DAILY_BUDGET=500
# NEWSCATCHER_DAILY_BUDGET=200

# ─── Free baselines (no keys) ───
# google_news_rss needs no credentials

# ─── Optional competitor adapters (BYOK) ───
NEWSCATCHER_API_KEY=
NEWSCATCHER_PLAN=

EVENTREGISTRY_API_KEY=
EVENTREGISTRY_PLAN=

WEBZ_API_KEY=
WEBZ_PLAN=

NEWSDATA_API_KEY=
NEWSDATA_PLAN=

NEWSAPI_ORG_API_KEY=
NEWSAPI_ORG_PLAN=

GNEWS_API_KEY=
GNEWS_PLAN=

# ─── Publish (optional) ───
# Local publish writes to ./results/. For S3-compatible upload:
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
